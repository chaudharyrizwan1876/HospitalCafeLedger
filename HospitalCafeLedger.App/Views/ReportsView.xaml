<UserControl x:Class="HospitalCafeLedger.App.Views.ReportsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#F4F6FA">

    <Grid>
        <!-- Header -->
        <Border Background="#032A63" Height="110" VerticalAlignment="Top">
            <Grid Margin="25">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Monthly Report" FontSize="28" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Generate and export doctor-wise monthly summaries"
                               FontSize="12" Foreground="#A0BFE0" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Margin="20,120,20,20">

            <!-- Filter Bar -->
            <Border Background="White" CornerRadius="12" Padding="18,14" Margin="0,0,0,14">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="1" Color="#CBD5E1" Opacity="0.4"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Month:" FontSize="13" FontWeight="SemiBold"
                               Foreground="#374151" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="MonthCombo" Grid.Column="1" Width="140" Height="38"
                              FontSize="13" Margin="0,0,16,0" Cursor="Hand"/>

                    <TextBlock Grid.Column="2" Text="Year:" FontSize="13" FontWeight="SemiBold"
                               Foreground="#374151" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="YearCombo" Grid.Column="3" Width="100" Height="38"
                              FontSize="13" Margin="0,0,20,0" Cursor="Hand"/>

                    <Button Grid.Column="4" Content="⚡  Generate Report" Height="38"
                            Padding="16,0" Background="#0E4DB5" Foreground="White"
                            BorderThickness="0" FontSize="13" FontWeight="Bold"
                            Cursor="Hand" Margin="0,0,10,0"
                            Click="GenerateReport_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#1D4ED8"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Grid.Column="5" Content="🖨  Export / Print" Height="38"
                            Padding="16,0" Background="#16A34A" Foreground="White"
                            BorderThickness="0" FontSize="13" FontWeight="Bold"
                            Cursor="Hand" Click="ExportPrint_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#15803D"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Period label right side -->
                    <TextBlock x:Name="PeriodLabel" Grid.Column="7"
                               Text="" FontSize="13" FontWeight="Bold"
                               Foreground="#0E4DB5" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Report Table -->
            <Border Background="White" CornerRadius="12" Padding="0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="1" Color="#CBD5E1" Opacity="0.4"/>
                </Border.Effect>
                <StackPanel>
                    <!-- Table Header -->
                    <Border Background="#032A63" CornerRadius="12,12,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0.6*"/>
                                <ColumnDefinition Width="1.4*"/>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="1.2*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="#" Padding="14,12" Foreground="White" FontWeight="Bold" FontSize="13"/>
                            <TextBlock Grid.Column="1" Text="Doctor" Padding="10,12" Foreground="White" FontWeight="Bold" FontSize="13"/>
                            <TextBlock Grid.Column="2" Text="Opening Balance" Padding="10,12" Foreground="White" FontWeight="Bold" FontSize="13"/>
                            <TextBlock Grid.Column="3" Text="Total Deposited" Padding="10,12" Foreground="White" FontWeight="Bold" FontSize="13"/>
                            <TextBlock Grid.Column="4" Text="Month Orders" Padding="10,12" Foreground="White" FontWeight="Bold" FontSize="13"/>
                            <TextBlock Grid.Column="5" Text="Available Balance" Padding="10,12" Foreground="White" FontWeight="Bold" FontSize="13"/>
                        </Grid>
                    </Border>

                    <!-- Data Rows -->
                    <ItemsControl x:Name="ReportTable">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#F8FAFC"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="0.6*"/>
                                            <ColumnDefinition Width="1.4*"/>
                                            <ColumnDefinition Width="1.2*"/>
                                            <ColumnDefinition Width="1.2*"/>
                                            <ColumnDefinition Width="1.2*"/>
                                            <ColumnDefinition Width="1.2*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Serial}" Padding="14,11"
                                                   FontSize="13" Foreground="#64748B" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="1" Text="{Binding DoctorName}" Padding="10,11"
                                                   FontSize="13" FontWeight="SemiBold" Foreground="#1E293B"/>
                                        <TextBlock Grid.Column="2" Text="{Binding OpeningBalDisplay}" Padding="10,11"
                                                   FontSize="13" Foreground="#374151"/>
                                        <TextBlock Grid.Column="3" Text="{Binding TotalDepositDisplay}" Padding="10,11"
                                                   FontSize="13" Foreground="#1D4ED8" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="4" Text="{Binding TotalOrdersDisplay}" Padding="10,11"
                                                   FontSize="13" Foreground="#D97706" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="5" Text="{Binding AvailableDisplay}" Padding="10,11"
                                                   FontSize="13" FontWeight="Bold"
                                                   Foreground="{Binding BalanceColor}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Empty State -->
                    <Border x:Name="EmptyReport" Padding="40" Visibility="Visible">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="📊" FontSize="40" HorizontalAlignment="Center"/>
                            <TextBlock Text="Select month &amp; year, then click Generate Report"
                                       FontSize="14" Foreground="#64748B"
                                       HorizontalAlignment="Center" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Grand Total Row -->
                    <Border x:Name="GrandTotalRow" Background="#032A63"
                            CornerRadius="0,0,12,12" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0.6*"/>
                                <ColumnDefinition Width="1.4*"/>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="1.2*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="∑" Padding="14,12"
                                       Foreground="White" FontWeight="Bold" FontSize="14"/>
                            <TextBlock Grid.Column="1" Text="Grand Total" Padding="10,12"
                                       Foreground="White" FontWeight="Bold" FontSize="13"/>
                            <TextBlock x:Name="GrandOpening" Grid.Column="2" Text="Rs. 0" Padding="10,12"
                                       Foreground="#A0BFE0" FontWeight="Bold" FontSize="13"/>
                            <TextBlock x:Name="GrandDeposits" Grid.Column="3" Text="Rs. 0" Padding="10,12"
                                       Foreground="#93C5FD" FontWeight="Bold" FontSize="13"/>
                            <TextBlock x:Name="GrandOrders" Grid.Column="4" Text="Rs. 0" Padding="10,12"
                                       Foreground="#FDE68A" FontWeight="Bold" FontSize="13"/>
                            <TextBlock x:Name="GrandBalance" Grid.Column="5" Text="Rs. 0" Padding="10,12"
                                       Foreground="#86EFAC" FontWeight="Bold" FontSize="13"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
