<UserControl x:Class="HospitalCafeLedger.App.Views.ReportsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#F4F6FA">

    <Grid>
        <Border Background="#032A63" Height="90" VerticalAlignment="Top">
            <TextBlock Text="Monthly Report" FontSize="30" FontWeight="Bold"
                       Foreground="White" Margin="25" VerticalAlignment="Center"/>
        </Border>

        <StackPanel Margin="25,100,25,25">
            <!-- Filters -->
            <Border Background="White" CornerRadius="10" Padding="20" Margin="0,0,0,15">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Select Month:" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox Width="130" Height="38" FontSize="14" SelectedIndex="4" Margin="0,0,20,0">
                        <ComboBoxItem Content="January"/>
                        <ComboBoxItem Content="February"/>
                        <ComboBoxItem Content="March"/>
                        <ComboBoxItem Content="April"/>
                        <ComboBoxItem Content="May"/>
                        <ComboBoxItem Content="June"/>
                        <ComboBoxItem Content="July"/>
                        <ComboBoxItem Content="August"/>
                        <ComboBoxItem Content="September"/>
                        <ComboBoxItem Content="October"/>
                        <ComboBoxItem Content="November"/>
                        <ComboBoxItem Content="December"/>
                    </ComboBox>
                    <TextBlock Text="Select Year:" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox Width="100" Height="38" FontSize="14" SelectedIndex="0" Margin="0,0,20,0">
                        <ComboBoxItem Content="2026"/>
                        <ComboBoxItem Content="2025"/>
                        <ComboBoxItem Content="2024"/>
                    </ComboBox>
                    <Button Content="Generate Report" Width="150" Height="38" Margin="0,0,15,0"
                            Background="#0E4DB5" Foreground="White" BorderThickness="0" FontWeight="Bold"/>
                    <Button Content="Export / Print" Width="130" Height="38"
                            Background="#22C55E" Foreground="White" BorderThickness="0" FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <!-- Report Table -->
            <Border Background="White" CornerRadius="10" Padding="20">
                <StackPanel>
                    <!-- Header -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="160"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="#032A63" Padding="10"><TextBlock Text="Doctor" Foreground="White" FontWeight="Bold"/></Border>
                        <Border Grid.Column="1" Background="#032A63" Padding="10"><TextBlock Text="Opening Balance" Foreground="White" FontWeight="Bold"/></Border>
                        <Border Grid.Column="2" Background="#032A63" Padding="10"><TextBlock Text="Total Charges" Foreground="White" FontWeight="Bold"/></Border>
                        <Border Grid.Column="3" Background="#032A63" Padding="10"><TextBlock Text="Total Payments" Foreground="White" FontWeight="Bold"/></Border>
                        <Border Grid.Column="4" Background="#032A63" Padding="10"><TextBlock Text="Remaining Balance" Foreground="White" FontWeight="Bold"/></Border>
                    </Grid>

                    <!-- Rows -->
                    <Grid Background="#F8FAFF"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/><ColumnDefinition Width="140"/><ColumnDefinition Width="150"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Dr. Ahmed Khan" Padding="10" FontSize="13"/>
                        <TextBlock Grid.Column="1" Text="Rs. 2,400" Padding="10" FontSize="13"/>
                        <TextBlock Grid.Column="2" Text="Rs. 8,450" Padding="10" FontSize="13"/>
                        <TextBlock Grid.Column="3" Text="Rs. 6,000" Padding="10" FontSize="13"/>
                        <TextBlock Grid.Column="4" Text="Rs. 2,450" Padding="10" FontSize="13" Foreground="Red" FontWeight="Bold"/>
                    </Grid>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/><ColumnDefinition Width="140"/><ColumnDefinition Width="150"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Dr. Ali Raza" Padding="10" FontSize="13"/>
                        <TextBlock Grid.Column="1" Text="Rs. 1,200" Padding="10" FontSize="13"/>
                        <TextBlock Grid.Column="2" Text="Rs. 5,620" Padding="10" FontSize="13"/>
                        <TextBlock Grid.Column="3" Text="Rs. 3,000" Padding="10" FontSize="13"/>
                        <TextBlock Grid.Column="4" Text="Rs. 3,820" Padding="10" FontSize="13" Foreground="Red" FontWeight="Bold"/>
                    </Grid>
                    <Grid Background="#F8FAFF"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/><ColumnDefinition Width="140"/><ColumnDefinition Width="150"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Dr. Usman" Padding="10" FontSize="13"/>
                        <TextBlock Grid.Column="1" Text="Rs. 3,500" Padding="10" FontSize="13"/>
                        <TextBlock Grid.Column="2" Text="Rs. 7,350" Padding="10" FontSize="13"/>
                        <TextBlock Grid.Column="3" Text="Rs. 4,000" Padding="10" FontSize="13"/>
                        <TextBlock Grid.Column="4" Text="Rs. 6,850" Padding="10" FontSize="13" Foreground="Red" FontWeight="Bold"/>
                    </Grid>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/><ColumnDefinition Width="140"/><ColumnDefinition Width="150"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Dr. Fatima Noor" Padding="10" FontSize="13"/>
                        <TextBlock Grid.Column="1" Text="Rs. 0" Padding="10" FontSize="13"/>
                        <TextBlock Grid.Column="2" Text="Rs. 4,120" Padding="10" FontSize="13"/>
                        <TextBlock Grid.Column="3" Text="Rs. 4,120" Padding="10" FontSize="13"/>
                        <TextBlock Grid.Column="4" Text="Rs. 0" Padding="10" FontSize="13" Foreground="Green" FontWeight="Bold"/>
                    </Grid>

                    <!-- Grand Total -->
                    <Border Background="#032A63" Padding="10" Margin="0,10,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/><ColumnDefinition Width="140"/><ColumnDefinition Width="150"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Grand Total" Foreground="White" FontWeight="Bold" Padding="0,0,0,0"/>
                            <TextBlock Grid.Column="1" Text="Rs. 7,100" Foreground="White" FontWeight="Bold"/>
                            <TextBlock Grid.Column="2" Text="Rs. 28,520" Foreground="White" FontWeight="Bold"/>
                            <TextBlock Grid.Column="3" Text="Rs. 18,120" Foreground="White" FontWeight="Bold"/>
                            <TextBlock Grid.Column="4" Text="Rs. 17,100" Foreground="#FCA5A5" FontWeight="Bold"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
