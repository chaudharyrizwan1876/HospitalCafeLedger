<Window x:Class="HospitalCafeLedger.App.Views.AddDoctorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Add New Doctor" Height="560" Width="520"
    WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F4F6FA">

    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Header -->
        <Border Background="#032A63" Height="72" VerticalAlignment="Top">
            <StackPanel Margin="25,0" VerticalAlignment="Center">
                <TextBlock Text="Add New Doctor" FontSize="20" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Fill in all details to register a new doctor" FontSize="12" Foreground="#A0BFE0"/>
            </StackPanel>
        </Border>

        <!-- Form Body -->
        <Border Margin="0,72,0,0" Padding="25,20">
            <StackPanel>
                <TextBlock Text="Doctor Name *" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="NameBox" Style="{StaticResource InputBox}"/>

                <TextBlock Text="Department *" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="DeptBox" Height="40" FontSize="14" Padding="8,0"
                          BorderBrush="#CBD5E1" Margin="0,0,0,12" SelectedIndex="0">
                    <ComboBoxItem Content="Cardiology"/>
                    <ComboBoxItem Content="ENT"/>
                    <ComboBoxItem Content="Orthopedic"/>
                    <ComboBoxItem Content="Gynecology"/>
                    <ComboBoxItem Content="Pediatrics"/>
                    <ComboBoxItem Content="Skin"/>
                    <ComboBoxItem Content="Eye"/>
                    <ComboBoxItem Content="General Medicine"/>
                    <ComboBoxItem Content="Surgery"/>
                    <ComboBoxItem Content="Neurology"/>
                    <ComboBoxItem Content="Radiology"/>
                </ComboBox>

                <TextBlock Text="Phone Number" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="PhoneBox" Style="{StaticResource InputBox}"/>

                <TextBlock Text="Opening Balance (Rs.)" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="BalanceBox" Style="{StaticResource InputBox}" Text="0"/>

                <Border Height="1" Background="#E2E8F0" Margin="0,8,0,16"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Content="Cancel" Height="44" Margin="0,0,8,0"
                            Background="#F1F5F9" BorderThickness="0" FontSize="14"
                            Cursor="Hand" Click="Cancel_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#E2E8F0"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Grid.Column="1" Content="✓  Add Doctor" Height="44"
                            Background="#0E4DB5" Foreground="White"
                            BorderThickness="0" FontSize="14" FontWeight="Bold"
                            Cursor="Hand" Click="Add_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#1D4ED8"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
