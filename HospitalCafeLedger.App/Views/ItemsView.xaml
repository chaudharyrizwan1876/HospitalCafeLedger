<UserControl x:Class="HospitalCafeLedger.App.Views.ItemsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#F4F6FA">

    <UserControl.Resources>
        <Style x:Key="EditBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#EFF6FF"/>
            <Setter Property="Foreground" Value="#1D4ED8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="8,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#DBEAFE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DelBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#FEF2F2"/>
            <Setter Property="Foreground" Value="#DC2626"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FEE2E2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Top Header -->
        <Border Background="#032A63" Height="110" VerticalAlignment="Top">
            <Grid Margin="25">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="160"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Items / Recipes" FontSize="28" FontWeight="Bold" Foreground="White"/>
                    <TextBlock x:Name="TotalCountText" Text="Loading..." FontSize="12" Foreground="#A0BFE0" Margin="0,2,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="+ Add Item" Height="42"
                        Background="White" Foreground="#032A63" FontWeight="Bold"
                        BorderThickness="0" Cursor="Hand" Click="AddItem_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="10,0">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#E8F0FE"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <!-- Main Content -->
        <StackPanel Margin="25,120,25,25">

            <!-- Search Bar -->
            <Border Background="White" CornerRadius="10" Padding="12,8" Margin="0,0,0,15"
                    BorderBrush="#E2E8F0" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="🔍" FontSize="16" VerticalAlignment="Center" Margin="4,0,8,0"/>
                    <TextBox x:Name="ItemSearchBox" Grid.Column="1"
                             Height="36" FontSize="14" BorderThickness="0"
                             VerticalContentAlignment="Center" Padding="4,0"
                             Background="Transparent"
                             TextChanged="SearchBox_TextChanged"/>
                    <TextBlock x:Name="SearchPlaceholder" Grid.Column="1"
                               Text="Search by name, ID or category..."
                               FontSize="14" Foreground="#94A3B8"
                               VerticalAlignment="Center" Margin="8,0"
                               IsHitTestVisible="False"/>
                    <Button x:Name="ClearBtn" Grid.Column="2" Content="✕"
                            Width="28" Height="28" Background="Transparent"
                            BorderThickness="0" Cursor="Hand" Foreground="#94A3B8"
                            Click="ClearSearch_Click" Visibility="Collapsed"/>
                </Grid>
            </Border>

            <!-- Table Card -->
            <Border Background="White" CornerRadius="12" Padding="0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Color="#E2E8F0" Opacity="0.6"/>
                </Border.Effect>
                <StackPanel>
                    <!-- Table Header -->
                    <Border Background="#032A63" CornerRadius="12,12,0,0">
                        <Grid Margin="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0.5*"/>
                                <ColumnDefinition Width="1.8*"/>
                                <ColumnDefinition Width="1.3*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="0.9*"/>
                                <ColumnDefinition Width="0.9*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="ID" Padding="15,14" Foreground="White" FontWeight="Bold" FontSize="13"/>
                            <TextBlock Grid.Column="1" Text="Item Name" Padding="10,14" Foreground="White" FontWeight="Bold" FontSize="13"/>
                            <TextBlock Grid.Column="2" Text="Category" Padding="10,14" Foreground="White" FontWeight="Bold" FontSize="13"/>
                            <TextBlock Grid.Column="3" Text="Price" Padding="10,14" Foreground="White" FontWeight="Bold" FontSize="13"/>
                            <TextBlock Grid.Column="4" Text="Status" Padding="10,14" Foreground="White" FontWeight="Bold" FontSize="13"/>
                            <TextBlock Grid.Column="5" Text="Actions" Padding="10,14" Foreground="White" FontWeight="Bold" FontSize="13"/>
                        </Grid>
                    </Border>

                    <!-- Rows -->
                    <ItemsControl x:Name="ItemsTable">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#F8FAFC"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="0.5*"/>
                                            <ColumnDefinition Width="1.8*"/>
                                            <ColumnDefinition Width="1.3*"/>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="0.9*"/>
                                            <ColumnDefinition Width="0.9*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Id}" Padding="15,12" FontSize="13" Foreground="#64748B" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" Padding="10,12" FontSize="13" FontWeight="SemiBold" Foreground="#1E293B"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Category}" Padding="10,12" FontSize="13" Foreground="#475569"/>
                                        <TextBlock Grid.Column="3" Text="{Binding PriceDisplay}" Padding="10,12" FontSize="13" Foreground="#059669" FontWeight="SemiBold"/>
                                        <Border Grid.Column="4" VerticalAlignment="Center" Margin="8,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#DCFCE7"/>
                                                    <Setter Property="CornerRadius" Value="12"/>
                                                    <Setter Property="Padding" Value="8,3"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                            <Setter Property="Background" Value="#FEE2E2"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding StatusDisplay}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#16A34A"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                <Setter Property="Foreground" Value="#DC2626"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                        <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
                                            <Button Style="{StaticResource EditBtn}"
                                                    Tag="{Binding Id}" Click="Edit_Click"
                                                    Margin="0,0,5,0" ToolTip="Edit Item">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="✏" FontSize="12" Margin="0,0,3,0"/>
                                                    <TextBlock Text="Edit" FontSize="12"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource DelBtn}"
                                                    Tag="{Binding Id}" Click="Delete_Click"
                                                    ToolTip="Delete Item">
                                                <TextBlock Text="🗑" FontSize="14"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Empty State -->
                    <Border x:Name="EmptyState" Visibility="Collapsed" Padding="40">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="🍽️" FontSize="48" HorizontalAlignment="Center"/>
                            <TextBlock Text="No items found" FontSize="16" FontWeight="Bold"
                                       Foreground="#64748B" HorizontalAlignment="Center" Margin="0,8,0,4"/>
                            <TextBlock Text="Try a different search or add a new item"
                                       FontSize="13" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
