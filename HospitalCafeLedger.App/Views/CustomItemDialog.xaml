<Window x:Class="HospitalCafeLedger.App.Views.CustomItemDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Custom Item" Height="320" Width="460"
    WindowStartupLocation="CenterOwner"
    ResizeMode="NoResize"
    Background="White">

    <Border Padding="30">
        <StackPanel>
            <TextBlock Text="Custom Item" FontSize="22" FontWeight="Bold" Margin="0,0,0,25"/>

            <TextBlock Text="Item Name" FontSize="13" Margin="0,0,0,6"/>
            <TextBox x:Name="ItemNameBox" Height="40" Padding="10" FontSize="14" Margin="0,0,0,15"
                     BorderBrush="#CBD5E1"/>

            <TextBlock Text="Price (Rs.)" FontSize="13" Margin="0,0,0,6"/>
            <TextBox x:Name="ItemPriceBox" Height="40" Padding="10" FontSize="14" Margin="0,0,0,15"
                     BorderBrush="#CBD5E1"/>

            <TextBlock Text="Category" FontSize="13" Margin="0,0,0,6"/>
            <ComboBox x:Name="CategoryBox" Height="40" Padding="10" FontSize="14" Margin="0,0,0,25"
                      SelectedIndex="0">
                <ComboBoxItem Content="Hot Drinks"/>
                <ComboBoxItem Content="Fast Food"/>
                <ComboBoxItem Content="Beverages"/>
                <ComboBoxItem Content="Meals"/>
                <ComboBoxItem Content="Breakfast"/>
                <ComboBoxItem Content="Dessert"/>
            </ComboBox>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Width="100" Height="40" Margin="0,0,10,0"
                        Background="#F1F5F9" BorderThickness="0"
                        Click="CancelButton_Click"/>
                <Button Content="Add Item" Width="120" Height="40"
                        Background="#0E4DB5" Foreground="White" BorderThickness="0" FontWeight="Bold"
                        Click="AddButton_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
