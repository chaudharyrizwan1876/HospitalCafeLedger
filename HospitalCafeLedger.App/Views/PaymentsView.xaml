<UserControl x:Class="HospitalCafeLedger.App.Views.PaymentsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#F4F6FA">

    <UserControl.Resources>
        <Style x:Key="DoctorItem" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#EFF6FF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#0E4DB5"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Header -->
        <Border Background="#032A63" Height="110" VerticalAlignment="Top">
            <Grid Margin="25">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Payments" FontSize="28" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Doctor wallet — track deposits, orders and available balance"
                               FontSize="12" Foreground="#A0BFE0" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3-Column Layout -->
        <Grid Margin="20,120,20,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- ═══ LEFT: Doctor List ═══ -->
            <Border Background="White" CornerRadius="12" Margin="0,0,10,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="1" Color="#CBD5E1" Opacity="0.4"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Background="#032A63" CornerRadius="12,12,0,0" Padding="15,12">
                        <TextBlock Text="Select Doctor" FontSize="14" FontWeight="Bold" Foreground="White"/>
                    </Border>
                    <Border Grid.Row="1" Margin="10,10,10,5" BorderBrush="#E2E8F0"
                            BorderThickness="1" CornerRadius="7">
                        <Grid>
                            <TextBlock Text="🔍" FontSize="13" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            <TextBox x:Name="DoctorSearchBox" Height="34" FontSize="12"
                                     BorderThickness="0" Background="Transparent"
                                     VerticalContentAlignment="Center" Padding="26,0,6,0"
                                     TextChanged="DoctorSearch_TextChanged"/>
                            <TextBlock x:Name="DoctorSearchPlaceholder" Text="Search doctor..."
                                       FontSize="12" Foreground="#94A3B8"
                                       VerticalAlignment="Center" Margin="28,0,0,0"
                                       IsHitTestVisible="False"/>
                        </Grid>
                    </Border>
                    <ListBox x:Name="PayDoctorList" Grid.Row="2"
                             BorderThickness="0" Background="Transparent"
                             Padding="8,0,8,8"
                             ItemContainerStyle="{StaticResource DoctorItem}"
                             SelectionChanged="DoctorList_SelectionChanged"/>
                </Grid>
            </Border>

            <!-- ═══ CENTER: Info + History ═══ -->
            <Border Grid.Column="1" Background="White" CornerRadius="12" Margin="0,0,10,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="1" Color="#CBD5E1" Opacity="0.4"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Wallet Summary -->
                    <Border Background="#F0F6FF" CornerRadius="12,12,0,0" Padding="18,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left: Name + dept -->
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Doctor Account" FontSize="11"
                                           Foreground="#64748B" FontWeight="SemiBold"/>
                                <TextBlock x:Name="DoctorInfoLabel" Text="— Select a doctor —"
                                           FontSize="17" FontWeight="Bold" Foreground="#1E293B"/>
                                <TextBlock x:Name="DeptLabel" Text="" FontSize="12" Foreground="#64748B"/>
                            </StackPanel>

                            <!-- Right: wallet figures -->
                            <Border Grid.Column="1" CornerRadius="10" Padding="14,10" MinWidth="230">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#F0FFF4"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsInDebt, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                <Setter Property="Background" Value="#FEF2F2"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Opening Balance" FontSize="12" Foreground="#374151"/>
                                        <TextBlock x:Name="OpeningBalLabel" Grid.Column="1" Text="Rs. 0"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   Foreground="#374151" Margin="12,0,0,0"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="+ Cash Deposits" FontSize="12" Foreground="#1D4ED8"/>
                                        <TextBlock x:Name="CashDepositsLabel" Grid.Column="1" Text="Rs. 0"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   Foreground="#1D4ED8" Margin="12,0,0,0"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="= Total Deposited" FontSize="12"
                                                   Foreground="#374151" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="TotalDepositedLabel" Grid.Column="1" Text="Rs. 0"
                                                   FontSize="12" FontWeight="Bold"
                                                   Foreground="#374151" Margin="12,0,0,0"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="− Orders Consumed" FontSize="12" Foreground="#D97706"/>
                                        <TextBlock x:Name="TotalOrdersLabel" Grid.Column="1" Text="Rs. 0"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   Foreground="#D97706" Margin="12,0,0,0"/>
                                    </Grid>
                                    <Border Height="1" Background="#E2E8F0" Margin="0,4,0,6"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="BalanceTitle" Text="Available Balance"
                                                   FontSize="13" FontWeight="Bold" Foreground="#16A34A"/>
                                        <TextBlock x:Name="AvailableBalanceLabel" Grid.Column="1" Text="Rs. 0"
                                                   FontSize="15" FontWeight="Bold"
                                                   Foreground="#16A34A" Margin="12,0,0,0"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Debt warning banner -->
                    <Border x:Name="DebtBanner" Grid.Row="1"
                            Background="#FEF2F2" Padding="16,10" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⚠  " FontSize="14" Foreground="#DC2626"/>
                            <TextBlock x:Name="DebtAmountRun" FontSize="12" Foreground="#DC2626"
                                       FontWeight="SemiBold" VerticalAlignment="Center"
                                       Text="Doctor owes Rs. 0 — deposits are less than orders placed"/>
                        </StackPanel>
                    </Border>

                    <!-- Table Header -->
                    <Border Grid.Row="2" Background="#032A63">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.3*"/>
                                <ColumnDefinition Width="1.1*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Date" Padding="15,11"
                                       Foreground="White" FontWeight="Bold" FontSize="13"/>
                            <TextBlock Grid.Column="1" Text="Amount Deposited"
                                       Padding="10,11" Foreground="White" FontWeight="Bold" FontSize="13"/>
                            <TextBlock Grid.Column="2" Text="Note"
                                       Padding="10,11" Foreground="White" FontWeight="Bold" FontSize="13"/>
                        </Grid>
                    </Border>

                    <!-- Payment / Deposit Rows -->
                    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <ItemsControl x:Name="PaymentHistoryList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#F8FAFC"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.3*"/>
                                                    <ColumnDefinition Width="1.1*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding DateDisplay}"
                                                           Padding="15,11" FontSize="13" Foreground="#475569"/>
                                                <TextBlock Grid.Column="1" Text="{Binding AmountDisplay}"
                                                           Padding="10,11" FontSize="13"
                                                           FontWeight="Bold" Foreground="#1D4ED8"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Notes}"
                                                           Padding="10,11" FontSize="13" Foreground="#64748B"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border x:Name="NoPaymentsMsg" Padding="30" Visibility="Visible">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="💳" FontSize="36" HorizontalAlignment="Center"/>
                                    <TextBlock Text="No deposits recorded yet"
                                               FontSize="13" Foreground="#94A3B8"
                                               HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                    <TextBlock Text="Opening balance is the first deposit"
                                               FontSize="11" Foreground="#CBD5E1"
                                               HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ═══ RIGHT: Add Deposit ═══ -->
            <Border Grid.Column="2" Background="White" CornerRadius="12">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="1" Color="#CBD5E1" Opacity="0.4"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Background="#032A63" CornerRadius="12,12,0,0" Padding="15,12">
                        <StackPanel>
                            <TextBlock Text="Add Deposit / Payment"
                                       FontSize="14" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="Add money to doctor's wallet"
                                       FontSize="11" Foreground="#A0BFE0"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Row="1" Margin="18,16,18,16">
                        <TextBlock Text="Amount (Rs.) *" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#374151" Margin="0,0,0,5"/>
                        <TextBox x:Name="PayAmountBox" Height="40" Padding="12,0"
                                 FontSize="14" VerticalContentAlignment="Center"
                                 BorderBrush="#CBD5E1" BorderThickness="1"
                                 Margin="0,0,0,14"/>

                        <TextBlock Text="Date *" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#374151" Margin="0,0,0,5"/>
                        <DatePicker x:Name="PayDatePicker" Height="40"
                                    FontSize="13" Margin="0,0,0,14"
                                    BorderBrush="#CBD5E1"/>

                        <TextBlock Text="Note (Optional)" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#374151" Margin="0,0,0,5"/>
                        <TextBox x:Name="PayNoteBox" Height="40" Padding="12,0"
                                 FontSize="14" VerticalContentAlignment="Center"
                                 BorderBrush="#CBD5E1" BorderThickness="1"
                                 Text="Cash Deposit" Margin="0,0,0,20"/>

                        <Button Content="✓  Save Deposit" Height="46"
                                Background="#0E4DB5" Foreground="White"
                                BorderThickness="0" FontSize="14" FontWeight="Bold"
                                Cursor="Hand" Click="SavePayment_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#1D4ED8"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Quick Wallet Summary Box -->
                        <Border Background="#F8FAFC" CornerRadius="10"
                                Padding="14,12" Margin="0,10,0,0"
                                BorderBrush="#E2E8F0" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Wallet Summary" FontSize="12" FontWeight="Bold"
                                           Foreground="#1E293B" Margin="0,0,0,10"/>
                                <Grid Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Opening Balance" FontSize="12" Foreground="#374151"/>
                                    <TextBlock x:Name="SummaryOpening" Grid.Column="1" Text="Rs. 0"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="#374151" Margin="10,0,0,0"/>
                                </Grid>
                                <Grid Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="+ Cash Deposits" FontSize="12" Foreground="#1D4ED8"/>
                                    <TextBlock x:Name="SummaryCash" Grid.Column="1" Text="Rs. 0"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="#1D4ED8" Margin="10,0,0,0"/>
                                </Grid>
                                <Grid Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="− Orders" FontSize="12" Foreground="#D97706"/>
                                    <TextBlock x:Name="SummaryOrders" Grid.Column="1" Text="Rs. 0"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="#D97706" Margin="10,0,0,0"/>
                                </Grid>
                                <Border Height="1" Background="#E2E8F0" Margin="0,4,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="SummaryBalTitle" Text="Available"
                                               FontSize="13" FontWeight="Bold" Foreground="#16A34A"/>
                                    <TextBlock x:Name="SummaryAvailable" Grid.Column="1" Text="Rs. 0"
                                               FontSize="15" FontWeight="Bold"
                                               Foreground="#16A34A" Margin="10,0,0,0"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
