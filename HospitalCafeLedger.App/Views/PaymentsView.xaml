<UserControl x:Class="HospitalCafeLedger.App.Views.PaymentsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#F4F6FA">

    <Grid>
        <Border Background="#032A63" Height="90" VerticalAlignment="Top">
            <TextBlock Text="Payments" FontSize="30" FontWeight="Bold"
                       Foreground="White" Margin="25" VerticalAlignment="Center"/>
        </Border>

        <Grid Margin="25,100,25,25">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Doctor List -->
            <Border Background="White" CornerRadius="10" Padding="15" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Select Doctor" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBox Height="38" Padding="8" Text="Search doctor..." FontSize="13" Margin="0,0,0,10"/>
                    <ListBox x:Name="PayDoctorList" Height="450" BorderThickness="0">
                        <ListBoxItem Content="D001 - Dr. Ahmed Khan" IsSelected="True"/>
                        <ListBoxItem Content="D002 - Dr. Ali Raza"/>
                        <ListBoxItem Content="D003 - Dr. Usman"/>
                        <ListBoxItem Content="D004 - Dr. Fatima Noor"/>
                        <ListBoxItem Content="D005 - Dr. Saad"/>
                        <ListBoxItem Content="D006 - Dr. Hamza"/>
                        <ListBoxItem Content="D007 - Dr. Zainab"/>
                    </ListBox>
                </StackPanel>
            </Border>

            <!-- Payment Panel -->
            <Grid Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="320"/>
                </Grid.ColumnDefinitions>

                <!-- Doctor Info + History -->
                <Border Background="White" CornerRadius="10" Padding="20" Margin="0,0,10,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Doctor Info" FontSize="13" Foreground="Gray"/>
                                <TextBlock Text="Dr. Ahmed Khan (D001)" FontSize="18" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                <TextBlock Text="Total: Rs. 8,450" FontSize="13"/>
                                <TextBlock Text="Paid: Rs. 6,000" FontSize="13"/>
                                <TextBlock Text="Remaining: Rs. 2,450" FontSize="14" FontWeight="Bold" Foreground="Red"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Payment History" FontSize="15" FontWeight="Bold" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="#032A63" Padding="8"><TextBlock Text="Date" Foreground="White" FontWeight="Bold"/></Border>
                            <Border Grid.Column="1" Background="#032A63" Padding="8"><TextBlock Text="Amount" Foreground="White" FontWeight="Bold"/></Border>
                            <Border Grid.Column="2" Background="#032A63" Padding="8"><TextBlock Text="Note" Foreground="White" FontWeight="Bold"/></Border>
                        </Grid>
                        <ListBox Height="320" BorderThickness="0,1,0,0" BorderBrush="#E0E0E0">
                            <ListBoxItem Content="20 May 2025    Rs. 2,000    Cash"/>
                            <ListBoxItem Content="15 May 2025    Rs. 1,500    Cash"/>
                            <ListBoxItem Content="10 May 2025    Rs. 2,500    Cash"/>
                        </ListBox>
                    </StackPanel>
                </Border>

                <!-- Add Payment -->
                <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Add Payment" FontSize="16" FontWeight="Bold" Margin="0,0,0,20"/>
                        <TextBlock Text="Amount (Rs.)" FontSize="13" Margin="0,0,0,6"/>
                        <TextBox x:Name="PayAmountBox" Height="40" Padding="10" FontSize="14" Margin="0,0,0,15"/>
                        <TextBlock Text="Date" FontSize="13" Margin="0,0,0,6"/>
                        <DatePicker x:Name="PayDatePicker" Height="40" Margin="0,0,0,15"/>
                        <TextBlock Text="Note (Optional)" FontSize="13" Margin="0,0,0,6"/>
                        <TextBox x:Name="PayNoteBox" Height="40" Padding="10" FontSize="14" Margin="0,0,0,25" Text="Cash Payment"/>
                        <Button Content="Save Payment" Height="44"
                                Background="#22C55E" Foreground="White" BorderThickness="0"
                                FontWeight="Bold" FontSize="15"
                                Click="SavePayment_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
