<UserControl x:Class="HospitalCafeLedger.App.Views.BillingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#F4F6FA">

    <UserControl.Resources>
        <!-- Quick Item Button Style -->
        <Style x:Key="QuickBtn" TargetType="Button">
            <Setter Property="Background" Value="#EFF6FF"/>
            <Setter Property="BorderBrush" Value="#BFDBFE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1E3A5F"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#DBEAFE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Action Button Style -->
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8"
                                Padding="12,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.88"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Doctor List Item Style -->
        <Style x:Key="DoctorItem" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#EFF6FF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#0E4DB5"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Header -->
        <Border Background="#032A63" Height="110" VerticalAlignment="Top">
            <Grid Margin="25">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Billing / New Order" FontSize="28" FontWeight="Bold" Foreground="White"/>
                    <TextBlock x:Name="HeaderSubtitle" Text="Select a doctor and add items to create an order"
                               FontSize="12" Foreground="#A0BFE0" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main 3-Column Layout -->
        <Grid Margin="20,120,20,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="270"/>
            </Grid.ColumnDefinitions>

            <!-- ===== LEFT: Doctor List ===== -->
            <Border Background="White" CornerRadius="12" Margin="0,0,10,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="1" Color="#CBD5E1" Opacity="0.4"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Background="#032A63" CornerRadius="12,12,0,0" Padding="15,12">
                        <TextBlock Text="Select Doctor" FontSize="14" FontWeight="Bold" Foreground="White"/>
                    </Border>

                    <!-- Search -->
                    <Border Grid.Row="1" Margin="10,10,10,5" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="7">
                        <Grid>
                            <TextBlock Text="🔍" FontSize="13" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            <TextBox x:Name="DoctorSearchBox" Height="34" FontSize="12"
                                     BorderThickness="0" Background="Transparent"
                                     VerticalContentAlignment="Center" Padding="26,0,6,0"
                                     TextChanged="DoctorSearch_TextChanged"/>
                            <TextBlock x:Name="DoctorSearchPlaceholder" Text="Search doctor..."
                                       FontSize="12" Foreground="#94A3B8"
                                       VerticalAlignment="Center" Margin="28,0,0,0"
                                       IsHitTestVisible="False"/>
                        </Grid>
                    </Border>

                    <!-- Doctor ListBox -->
                    <ListBox x:Name="DoctorListBox" Grid.Row="2"
                             BorderThickness="0" Background="Transparent"
                             Padding="8,0,8,8"
                             ItemContainerStyle="{StaticResource DoctorItem}"
                             SelectionChanged="DoctorListBox_SelectionChanged"/>
                </Grid>
            </Border>

            <!-- ===== CENTER: Order Panel ===== -->
            <Border Grid.Column="1" Background="White" CornerRadius="12" Margin="0,0,10,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="1" Color="#CBD5E1" Opacity="0.4"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Selected Doctor Info -->
                    <Border Grid.Row="0" Background="#F0F6FF" CornerRadius="12,12,0,0" Padding="18,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Selected Doctor" FontSize="11" Foreground="#64748B" FontWeight="SemiBold"/>
                                <TextBlock x:Name="SelectedDoctorLabel" Text="— No doctor selected —"
                                           FontSize="16" FontWeight="Bold" Foreground="#1E293B"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="Opening Balance" FontSize="11" Foreground="#64748B" HorizontalAlignment="Right"/>
                                <TextBlock x:Name="OpeningBalanceLabel" Text="Rs. 0"
                                           FontSize="15" FontWeight="Bold" Foreground="#DC2626" HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Table Header -->
                    <Border Grid.Row="1" Background="#032A63" Margin="0">
                        <Grid Margin="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="55"/>
                                <ColumnDefinition Width="75"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Item" Padding="15,10" Foreground="White" FontWeight="Bold" FontSize="13"/>
                            <TextBlock Grid.Column="1" Text="Qty" Padding="5,10" Foreground="White" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="Price" Padding="5,10" Foreground="White" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="Total" Padding="5,10" Foreground="White" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="4" Text="" Padding="5,10" Foreground="White" FontWeight="Bold" FontSize="13"/>
                        </Grid>
                    </Border>

                    <!-- Order Rows -->
                    <ItemsControl x:Name="OrderItemsList" Grid.Row="3">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#F8FAFC"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="55"/>
                                            <ColumnDefinition Width="75"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="40"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding ItemName}" Padding="15,10" FontSize="13" FontWeight="SemiBold" Foreground="#1E293B"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Qty}" Padding="5,10" FontSize="13" Foreground="#475569" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding PriceDisplay}" Padding="5,10" FontSize="13" Foreground="#475569" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{Binding TotalDisplay}" Padding="5,10" FontSize="13" FontWeight="Bold" Foreground="#059669" HorizontalAlignment="Center"/>
                                        <Button Grid.Column="4" Content="✕" Width="28" Height="28"
                                                Background="Transparent" BorderThickness="0"
                                                Foreground="#DC2626" FontSize="13" FontWeight="Bold"
                                                Cursor="Hand" Tag="{Binding ItemName}"
                                                Click="RemoveItem_Click" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Empty cart state -->
                    <Border x:Name="EmptyCartMsg" Grid.Row="3" Padding="20" Visibility="Visible">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="🛒" FontSize="36" HorizontalAlignment="Center"/>
                            <TextBlock Text="No items added yet" FontSize="13" Foreground="#94A3B8"
                                       HorizontalAlignment="Center" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Total -->
                    <Border Grid.Row="4" Background="#F8FAFC" Padding="15,12" Margin="0,0,0,0">
                        <Grid>
                            <TextBlock Text="Total Amount:" FontSize="15" FontWeight="Bold" Foreground="#374151" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TotalAmountLabel" Text="Rs. 0"
                                       FontSize="20" FontWeight="Bold" Foreground="#0E4DB5"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Action Buttons -->
                    <Grid Grid.Row="5" Margin="15,10,15,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Content="🗑  Clear Order" Height="44" Margin="0,0,6,0"
                                Background="#FEE2E2" Foreground="#DC2626"
                                Style="{StaticResource ActionBtn}"
                                Click="ClearOrderButton_Click"/>
                        <Button Grid.Column="1" Content="✓  Save Order" Height="44"
                                Background="#16A34A" Foreground="White"
                                Style="{StaticResource ActionBtn}"
                                Click="SaveOrderButton_Click"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- ===== RIGHT: Quick Items ===== -->
            <Border Grid.Column="2" Background="White" CornerRadius="12">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="1" Color="#CBD5E1" Opacity="0.4"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Background="#032A63" CornerRadius="12,12,0,0" Padding="15,12">
                        <TextBlock Text="Quick Items" FontSize="14" FontWeight="Bold" Foreground="White"/>
                    </Border>

                    <!-- Dynamic Quick Items from DB -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="10">
                        <ItemsControl x:Name="QuickItemsPanel">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Width="110" Height="60" Margin="4"
                                            Style="{StaticResource QuickBtn}"
                                            Tag="{Binding Tag}"
                                            Click="QuickItem_Click">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                                            <TextBlock Text="{Binding PriceText}" FontSize="11" Foreground="#059669" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Custom Item Button -->
                    <Button Grid.Row="2" Content="+ Custom Item" Height="44" Margin="10,0,10,10"
                            Background="#032A63" Foreground="White"
                            BorderThickness="0" FontWeight="Bold" FontSize="13"
                            Cursor="Hand" Click="CustomItemButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#0E4DB5"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
