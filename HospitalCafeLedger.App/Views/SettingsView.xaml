<UserControl x:Class="HospitalCafeLedger.App.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#F4F6FA">

    <Grid>
        <Border Background="#032A63" Height="90" VerticalAlignment="Top">
            <TextBlock Text="Settings" FontSize="30" FontWeight="Bold"
                       Foreground="White" Margin="25" VerticalAlignment="Center"/>
        </Border>

        <ScrollViewer Margin="25,100,25,25" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="700" HorizontalAlignment="Left">
                <Border Background="White" CornerRadius="10" Padding="25" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="Cafe Information" FontSize="17" FontWeight="Bold" Margin="0,0,0,20"/>
                        <TextBlock Text="Cafe Name" FontSize="13" Margin="0,0,0,6"/>
                        <TextBox Height="40" Padding="10" Text="Hospital Cafe" FontSize="14" Margin="0,0,0,15"/>
                        <TextBlock Text="Hospital Name" FontSize="13" Margin="0,0,0,6"/>
                        <TextBox Height="40" Padding="10" Text="City General Hospital" FontSize="14" Margin="0,0,0,15"/>
                        <TextBlock Text="Contact Number" FontSize="13" Margin="0,0,0,6"/>
                        <TextBox Height="40" Padding="10" FontSize="14" Margin="0,0,0,5"/>
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="10" Padding="25" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="App Preferences" FontSize="17" FontWeight="Bold" Margin="0,0,0,20"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <CheckBox Content="Show pending balance warning" IsChecked="True" FontSize="14"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <CheckBox Content="Auto-backup on close" IsChecked="True" FontSize="14"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <CheckBox Content="Show today's orders on dashboard" IsChecked="True" FontSize="14"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Button Content="Save Settings" Width="160" Height="44" HorizontalAlignment="Left"
                        Background="#0E4DB5" Foreground="White" BorderThickness="0"
                        FontWeight="Bold" FontSize="15"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
