<UserControl x:Class="HospitalCafeLedger.App.Views.PredictionsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#F4F6FA">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <!-- Header -->
            <Border Background="#032A63" Padding="25,20">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="🔮  AI Insights" FontSize="28" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="ML-powered forecasts based on your real data"
                               FontSize="12" Foreground="#A0BFE0" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <StackPanel Margin="22,18,22,22">

                <!-- ── Row 1: Next Month Sales + Doctor Warnings ── -->
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Next Month Sales Prediction -->
                    <Border Background="White" CornerRadius="12" Margin="0,0,10,0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="1" Color="#CBD5E1" Opacity="0.35"/>
                        </Border.Effect>
                        <StackPanel>
                            <Border Background="#0E4DB5" CornerRadius="12,12,0,0" Padding="18,14">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📈" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <StackPanel>
                                        <TextBlock Text="Next Month Sales Forecast" FontSize="15"
                                                   FontWeight="Bold" Foreground="White"/>
                                        <TextBlock Text="Based on historical order data"
                                                   FontSize="11" Foreground="#93C5FD"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Grid Margin="18,16,18,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="NextMonthName" Text="Next Month"
                                               FontSize="13" Foreground="#64748B" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="PredictedSalesLabel" Text="Rs. 0"
                                               FontSize="30" FontWeight="Bold" Foreground="#0E4DB5" Margin="0,4,0,0"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <TextBlock x:Name="SalesTrendIcon" Text="↑" FontSize="16"
                                                   Foreground="#16A34A" FontWeight="Bold"/>
                                        <TextBlock x:Name="SalesTrendLabel" Text=" 0% vs last month"
                                                   FontSize="13" Foreground="#64748B" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                    <Border Background="#F0F6FF" CornerRadius="8" Padding="12,10">
                                        <StackPanel>
                                            <TextBlock Text="Last Month" FontSize="11"
                                                       Foreground="#64748B" HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="LastMonthSalesLabel" Text="Rs. 0"
                                                       FontSize="18" FontWeight="Bold"
                                                       Foreground="#374151" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                            <Border Margin="0,8,0,0" CornerRadius="12" Padding="8,3">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#DCFCE7"/>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock x:Name="ConfidenceLabel" Text="Confidence: —"
                                                           FontSize="11" FontWeight="Bold"
                                                           Foreground="#166534" HorizontalAlignment="Center"/>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Doctor Balance Warnings -->
                    <Border Grid.Column="1" Background="White" CornerRadius="12" Margin="10,0,0,0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="1" Color="#CBD5E1" Opacity="0.35"/>
                        </Border.Effect>
                        <StackPanel>
                            <Border Background="#DC2626" CornerRadius="12,12,0,0" Padding="18,14">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚠️" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <StackPanel>
                                        <TextBlock Text="Doctor Balance Warnings" FontSize="15"
                                                   FontWeight="Bold" Foreground="White"/>
                                        <TextBlock Text="Predicted days until balance runs out"
                                                   FontSize="11" Foreground="#FECACA"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <StackPanel Margin="0,4,0,8">
                                <ItemsControl x:Name="WarningsList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="18,10" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding DoctorName}"
                                                                   FontSize="13" FontWeight="SemiBold" Foreground="#1E293B"/>
                                                        <TextBlock Text="{Binding BalanceText}"
                                                                   FontSize="11" Foreground="#64748B"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                                        <TextBlock Text="{Binding DaysText}"
                                                                   FontSize="12" Foreground="#D97706" FontWeight="SemiBold"
                                                                   HorizontalAlignment="Right"/>
                                                        <TextBlock Text="avg daily spend"
                                                                   FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Right"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="2" CornerRadius="12" Padding="8,3"
                                                            VerticalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#FEE2E2"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding WarningLevel}" Value="Warning">
                                                                        <Setter Property="Background" Value="#FEF9C3"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding WarningLevel}" FontSize="11"
                                                                   FontWeight="Bold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="#DC2626"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding WarningLevel}" Value="Warning">
                                                                            <Setter Property="Foreground" Value="#92400E"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="NoWarningsMsg"
                                           Text="✅  All doctors have healthy balances"
                                           FontSize="13" Foreground="#16A34A" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" Margin="0,20,0,10"
                                           Visibility="Collapsed"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ── Row 2: Item Trends ── -->
                <Border Background="White" CornerRadius="12" Margin="0,0,0,18">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="1" Color="#CBD5E1" Opacity="0.35"/>
                    </Border.Effect>
                    <StackPanel>
                        <Border Background="#16A34A" CornerRadius="12,12,0,0" Padding="18,14">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📊" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <StackPanel>
                                    <TextBlock Text="Item Sales Trends &amp; Next Month Forecast"
                                               FontSize="15" FontWeight="Bold" Foreground="White"/>
                                    <TextBlock Text="This month vs last month — with prediction"
                                               FontSize="11" Foreground="#BBF7D0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Table Header -->
                        <Border Background="#F8FAFC" Padding="18,9">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Item" FontSize="12" FontWeight="Bold" Foreground="#64748B"/>
                                <TextBlock Grid.Column="1" Text="Last Month" FontSize="12" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="This Month" FontSize="12" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="Next Month Est." FontSize="12" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="4" Text="Trend" FontSize="12" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <ItemsControl x:Name="ItemTrendsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="18,10">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#F8FAFC"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.5*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding ItemName}" FontSize="13"
                                                       FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding LastMonthText}"
                                                       FontSize="13" Foreground="#64748B"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding ThisMonthText}"
                                                       FontSize="13" FontWeight="Bold" Foreground="#0E4DB5"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="{Binding NextMonthText}"
                                                       FontSize="13" FontWeight="Bold" Foreground="#16A34A"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Border Grid.Column="4" CornerRadius="10" Padding="8,3"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    Background="{Binding TrendBg}">
                                                <TextBlock Text="{Binding Trend}" FontSize="11"
                                                           FontWeight="Bold" Foreground="{Binding TrendFg}"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock x:Name="NoTrendsMsg" Text="No item data available yet"
                                   FontSize="13" Foreground="#94A3B8"
                                   HorizontalAlignment="Center" Margin="0,20,0,16"
                                   Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <!-- ── Row 3: Peak Days + Peak Hours ── -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Peak Days -->
                    <Border Background="White" CornerRadius="12" Margin="0,0,10,0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="1" Color="#CBD5E1" Opacity="0.35"/>
                        </Border.Effect>
                        <StackPanel>
                            <Border Background="#D97706" CornerRadius="12,12,0,0" Padding="18,14">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📅" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <StackPanel>
                                        <TextBlock Text="Peak Days Analysis" FontSize="15"
                                                   FontWeight="Bold" Foreground="White"/>
                                        <TextBlock x:Name="PeakDaySubtitle" Text="Busiest day: —"
                                                   FontSize="11" Foreground="#FDE68A"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <ItemsControl x:Name="PeakDaysList" Margin="18,12,18,12">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="35"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding DayName}" FontSize="12"
                                                       Foreground="#374151" VerticalAlignment="Center"/>
                                            <Grid Grid.Column="1" Margin="8,0">
                                                <Border Background="#E2E8F0" CornerRadius="4" Height="10"/>
                                                <Border Background="#D97706" CornerRadius="4" Height="10"
                                                        HorizontalAlignment="Left"
                                                        Width="{Binding BarPx}"/>
                                            </Grid>
                                            <TextBlock Grid.Column="2" Text="{Binding Count}"
                                                       FontSize="12" FontWeight="Bold"
                                                       Foreground="#92400E" HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Peak Hours -->
                    <Border Grid.Column="1" Background="White" CornerRadius="12" Margin="10,0,0,0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="1" Color="#CBD5E1" Opacity="0.35"/>
                        </Border.Effect>
                        <StackPanel>
                            <Border Background="#7C3AED" CornerRadius="12,12,0,0" Padding="18,14">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⏰" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <StackPanel>
                                        <TextBlock Text="Peak Hours Analysis" FontSize="15"
                                                   FontWeight="Bold" Foreground="White"/>
                                        <TextBlock x:Name="PeakHourSubtitle" Text="Busiest hour: —"
                                                   FontSize="11" Foreground="#DDD6FE"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <ItemsControl x:Name="PeakHoursList" Margin="18,12,18,12">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="65"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="35"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding HourLabel}" FontSize="11"
                                                       Foreground="#374151" VerticalAlignment="Center"/>
                                            <Grid Grid.Column="1" Margin="8,0">
                                                <Border Background="#E2E8F0" CornerRadius="4" Height="10"/>
                                                <Border Background="#7C3AED" CornerRadius="4" Height="10"
                                                        HorizontalAlignment="Left"
                                                        Width="{Binding BarPx}"/>
                                            </Grid>
                                            <TextBlock Grid.Column="2" Text="{Binding Count}"
                                                       FontSize="11" FontWeight="Bold"
                                                       Foreground="#5B21B6" HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>

            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
