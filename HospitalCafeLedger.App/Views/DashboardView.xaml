<UserControl x:Class="HospitalCafeLedger.App.Views.DashboardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#F4F6FA">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <!-- Header -->
            <Border Background="#032A63" Padding="25,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Dashboard" FontSize="28" FontWeight="Bold" Foreground="White"/>
                        <TextBlock x:Name="SubtitleText" Text="" FontSize="12" Foreground="#A0BFE0" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="14,8">
                        <TextBlock x:Name="TodayDateLabel" FontSize="14" FontWeight="SemiBold" Foreground="#032A63"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Body -->
            <StackPanel Margin="22,18,22,22">

                <!-- ── Top 4 Stat Cards ── -->
                <UniformGrid Columns="4" Margin="0,0,0,18">

                    <!-- Today Sales -->
                    <Border Background="White" CornerRadius="12" Margin="0,0,10,0">
                        <Border.Effect><DropShadowEffect BlurRadius="10" ShadowDepth="1" Color="#CBD5E1" Opacity="0.35"/></Border.Effect>
                        <Grid Margin="18,16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Today Sales" FontSize="13" Foreground="#64748B" FontWeight="SemiBold"/>
                                <TextBlock x:Name="TodaySalesLabel" Text="Rs. 0"
                                           FontSize="26" FontWeight="Bold" Foreground="#16A34A" Margin="0,4,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="🛒" FontSize="28" VerticalAlignment="Center" Foreground="#E2E8F0"/>
                        </Grid>
                    </Border>

                    <!-- Total Pending -->
                    <Border Background="White" CornerRadius="12" Margin="5,0,5,0">
                        <Border.Effect><DropShadowEffect BlurRadius="10" ShadowDepth="1" Color="#CBD5E1" Opacity="0.35"/></Border.Effect>
                        <Grid Margin="18,16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Total Pending" FontSize="13" Foreground="#64748B" FontWeight="SemiBold"/>
                                <TextBlock x:Name="TotalPendingLabel" Text="Rs. 0"
                                           FontSize="26" FontWeight="Bold" Foreground="#DC2626" Margin="0,4,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="⏳" FontSize="28" VerticalAlignment="Center" Foreground="#E2E8F0"/>
                        </Grid>
                    </Border>

                    <!-- Total Doctors -->
                    <Border Background="White" CornerRadius="12" Margin="5,0,5,0">
                        <Border.Effect><DropShadowEffect BlurRadius="10" ShadowDepth="1" Color="#CBD5E1" Opacity="0.35"/></Border.Effect>
                        <Grid Margin="18,16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Total Doctors" FontSize="13" Foreground="#64748B" FontWeight="SemiBold"/>
                                <TextBlock x:Name="TotalDoctorsLabel" Text="0"
                                           FontSize="26" FontWeight="Bold" Foreground="#1D4ED8" Margin="0,4,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="👨‍⚕️" FontSize="28" VerticalAlignment="Center" Foreground="#E2E8F0"/>
                        </Grid>
                    </Border>

                    <!-- Today Orders -->
                    <Border Background="White" CornerRadius="12" Margin="10,0,0,0">
                        <Border.Effect><DropShadowEffect BlurRadius="10" ShadowDepth="1" Color="#CBD5E1" Opacity="0.35"/></Border.Effect>
                        <Grid Margin="18,16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Today Orders" FontSize="13" Foreground="#64748B" FontWeight="SemiBold"/>
                                <TextBlock x:Name="TodayOrdersLabel" Text="0"
                                           FontSize="26" FontWeight="Bold" Foreground="#D97706" Margin="0,4,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="📋" FontSize="28" VerticalAlignment="Center" Foreground="#E2E8F0"/>
                        </Grid>
                    </Border>
                </UniformGrid>

                <!-- ── Row 2: Chart + Top Items ── -->
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Monthly Sales Chart -->
                    <Border Background="White" CornerRadius="12" Margin="0,0,10,0">
                        <Border.Effect><DropShadowEffect BlurRadius="10" ShadowDepth="1" Color="#CBD5E1" Opacity="0.35"/></Border.Effect>
                        <StackPanel Margin="18,16,18,16">
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="📅  Monthly Sales Overview" FontSize="14" FontWeight="Bold" Foreground="#1E293B"/>
                                <TextBlock x:Name="ChartMonthLabel" Grid.Column="1"
                                           FontSize="12" Foreground="#64748B" VerticalAlignment="Center"/>
                            </Grid>
                            <!-- Chart Canvas -->
                            <Canvas x:Name="SalesChart" Height="220" Background="Transparent"/>
                        </StackPanel>
                    </Border>

                    <!-- Top Items -->
                    <Border Grid.Column="1" Background="White" CornerRadius="12" Margin="10,0,0,0">
                        <Border.Effect><DropShadowEffect BlurRadius="10" ShadowDepth="1" Color="#CBD5E1" Opacity="0.35"/></Border.Effect>
                        <StackPanel Margin="18,16,18,16">
                            <TextBlock Text="📊  Top Items (This Month)" FontSize="14" FontWeight="Bold"
                                       Foreground="#1E293B" Margin="0,0,0,14"/>

                            <ItemsControl x:Name="TopItemsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,12">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="6"/>
                                            </Grid.RowDefinitions>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" FontSize="13"
                                                           Foreground="#374151" FontWeight="SemiBold"/>
                                                <TextBlock Grid.Column="1" Text="{Binding OrderCount}"
                                                           FontSize="13" Foreground="#64748B" FontWeight="Bold"/>
                                            </Grid>
                                            <!-- Bar -->
                                            <Grid Grid.Row="1" Margin="0,4,0,0">
                                                <Border Background="#E2E8F0" CornerRadius="3" Height="6"/>
                                                <Border Background="#0E4DB5" CornerRadius="3" Height="6"
                                                        HorizontalAlignment="Left"
                                                        Width="{Binding BarPixelWidth}"/>
                                            </Grid>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock x:Name="NoItemsMsg" Text="No orders this month"
                                       FontSize="13" Foreground="#94A3B8"
                                       HorizontalAlignment="Center" Margin="0,20,0,0"
                                       Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ── Row 3: Recent Transactions + Pending Summary ── -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Recent Transactions -->
                    <Border Background="White" CornerRadius="12" Margin="0,0,10,0">
                        <Border.Effect><DropShadowEffect BlurRadius="10" ShadowDepth="1" Color="#CBD5E1" Opacity="0.35"/></Border.Effect>
                        <StackPanel Margin="18,16,18,16">
                            <TextBlock Text="📝  Recent Transactions" FontSize="14" FontWeight="Bold"
                                       Foreground="#1E293B" Margin="0,0,0,12"/>

                            <!-- Table Header -->
                            <Border Background="#F8FAFC" CornerRadius="6" Padding="10,7" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.2*"/>
                                        <ColumnDefinition Width="1.8*"/>
                                        <ColumnDefinition Width="0.8*"/>
                                        <ColumnDefinition Width="1.3*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Doctor" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                                    <TextBlock Grid.Column="1" Text="Items" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                                    <TextBlock Grid.Column="2" Text="Amount" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                                    <TextBlock Grid.Column="3" Text="Date / Time" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                                </Grid>
                            </Border>

                            <ItemsControl x:Name="RecentTxList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="10,9">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#F8FAFC"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.2*"/>
                                                    <ColumnDefinition Width="1.8*"/>
                                                    <ColumnDefinition Width="0.8*"/>
                                                    <ColumnDefinition Width="1.3*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding DoctorName}" FontSize="13"
                                                           FontWeight="SemiBold" Foreground="#1E293B"/>
                                                <TextBlock Grid.Column="1" Text="{Binding ItemsSummary}"
                                                           FontSize="12" Foreground="#475569" TextWrapping="Wrap"/>
                                                <TextBlock Grid.Column="2" Text="{Binding AmountDisplay}"
                                                           FontSize="13" FontWeight="Bold" Foreground="#16A34A"/>
                                                <TextBlock Grid.Column="3" Text="{Binding DateDisplay}"
                                                           FontSize="11" Foreground="#94A3B8"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock x:Name="NoTxMsg" Text="No transactions yet"
                                       FontSize="13" Foreground="#94A3B8"
                                       HorizontalAlignment="Center" Margin="0,20,0,0"
                                       Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>

                    <!-- Pending Summary -->
                    <Border Grid.Column="1" Background="White" CornerRadius="12" Margin="10,0,0,0">
                        <Border.Effect><DropShadowEffect BlurRadius="10" ShadowDepth="1" Color="#CBD5E1" Opacity="0.35"/></Border.Effect>
                        <StackPanel Margin="18,16,18,16">
                            <TextBlock Text="⏰  Pending Summary" FontSize="14" FontWeight="Bold"
                                       Foreground="#1E293B" Margin="0,0,0,16"/>

                            <!-- Total Pending Amount -->
                            <Border Background="#FEF2F2" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Total Pending Amount" FontSize="12" Foreground="#991B1B" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="PendingAmountLabel" Grid.Column="1" Text="Rs. 0"
                                               FontSize="14" FontWeight="Bold" Foreground="#DC2626"/>
                                </Grid>
                            </Border>

                            <!-- Doctors with Pending -->
                            <Border Background="#FFF9F0" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Doctors with Pending" FontSize="12" Foreground="#92400E" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="PendingDoctorsLabel" Grid.Column="1" Text="0"
                                               FontSize="14" FontWeight="Bold" Foreground="#D97706"/>
                                </Grid>
                            </Border>

                            <!-- Advance Credit -->
                            <Border Background="#F0FFF4" CornerRadius="8" Padding="14,12">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Advance / Credit" FontSize="12" Foreground="#166534" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="AdvanceCreditLabel" Grid.Column="1" Text="Rs. 0"
                                               FontSize="14" FontWeight="Bold" Foreground="#16A34A"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>

            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
