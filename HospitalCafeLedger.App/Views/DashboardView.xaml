<UserControl x:Class="HospitalCafeLedger.App.Views.DashboardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#F4F6FA">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <StackPanel>

            <!-- Header -->
            <Border Background="#032A63"
                    Padding="25">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="260"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Dashboard"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="White"/>

                    <Border Grid.Column="1"
                            Background="White"
                            CornerRadius="8"
                            Padding="15"
                            HorizontalAlignment="Right">

                        <TextBlock Text="Sunday, 25 May 2026"
                                   FontSize="16"/>

                    </Border>

                </Grid>

            </Border>

            <!-- Body -->
            <Grid Margin="28">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <UniformGrid Grid.Row="0"
                             Columns="4"
                             Margin="0,0,0,20">

                    <Border Background="White" CornerRadius="10" Margin="8" Padding="18">
                        <StackPanel>
                            <TextBlock Text="Today Sales"/>
                            <TextBlock Text="Rs. 7,540"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       Foreground="Green"/>
                        </StackPanel>
                    </Border>

                    <Border Background="White" CornerRadius="10" Margin="8" Padding="18">
                        <StackPanel>
                            <TextBlock Text="Total Pending"/>
                            <TextBlock Text="Rs. 42,350"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       Foreground="Red"/>
                        </StackPanel>
                    </Border>

                    <Border Background="White" CornerRadius="10" Margin="8" Padding="18">
                        <StackPanel>
                            <TextBlock Text="Total Doctors"/>
                            <TextBlock Text="45"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       Foreground="#1D4ED8"/>
                        </StackPanel>
                    </Border>

                    <Border Background="White" CornerRadius="10" Margin="8" Padding="18">
                        <StackPanel>
                            <TextBlock Text="Today Orders"/>
                            <TextBlock Text="52"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       Foreground="Orange"/>
                        </StackPanel>
                    </Border>

                </UniformGrid>

            </Grid>

        </StackPanel>

    </ScrollViewer>
</UserControl>