<UserControl x:Class="HospitalCafeLedger.App.Views.BackupView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#F4F6FA">

    <Grid>
        <!-- Header -->
        <Border Background="#032A63" Height="110" VerticalAlignment="Top">
            <Grid Margin="25">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Backup / Restore" FontSize="28" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Safely backup your database or restore from a previous backup"
                               FontSize="12" Foreground="#A0BFE0" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2-Column Layout -->
        <Grid Margin="20,120,20,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ═══ LEFT: Create Backup ═══ -->
            <Border Background="White" CornerRadius="14" Margin="0,0,10,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Color="#CBD5E1" Opacity="0.4"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Card Header -->
                    <Border Background="#16A34A" CornerRadius="14,14,0,0" Padding="25,20">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💾" FontSize="28" VerticalAlignment="Center" Margin="0,0,14,0"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Create Backup" FontSize="20" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="Save a copy of your entire database"
                                           FontSize="12" Foreground="#BBF7D0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Card Body -->
                    <StackPanel Grid.Row="1" Margin="25,24,25,0">
                        <TextBlock Text="Backup Location" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#374151" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="BackupPathBox" Height="42" Padding="12,0"
                                     FontSize="13" VerticalContentAlignment="Center"
                                     BorderBrush="#CBD5E1" BorderThickness="1"
                                     Background="#F8FAFC" IsReadOnly="True"/>
                            <Button Grid.Column="1" Content="📂  Browse" Height="42"
                                    Padding="14,0" Margin="8,0,0,0"
                                    Background="#E2E8F0" BorderBrush="#CBD5E1"
                                    BorderThickness="1" FontSize="13" Cursor="Hand"
                                    Click="BrowseBackupFolder_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="7">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#CBD5E1"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                        <TextBlock Text="Backup file will be saved as:  hospitalcafe_YYYYMMDD_HHMMSS.db"
                                   FontSize="11" Foreground="#94A3B8" Margin="0,4,0,20"/>

                        <!-- Info Box -->
                        <Border Background="#F0FFF4" CornerRadius="8" Padding="14,12"
                                BorderBrush="#BBF7D0" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="ℹ  What gets backed up?" FontSize="12"
                                           FontWeight="Bold" Foreground="#166534" Margin="0,0,0,6"/>
                                <TextBlock Text="• All Doctors / Members records"
                                           FontSize="12" Foreground="#374151" Margin="0,2"/>
                                <TextBlock Text="• All Items / Recipes"
                                           FontSize="12" Foreground="#374151" Margin="0,2"/>
                                <TextBlock Text="• All Orders and Billing history"
                                           FontSize="12" Foreground="#374151" Margin="0,2"/>
                                <TextBlock Text="• All Payment records"
                                           FontSize="12" Foreground="#374151" Margin="0,2"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Create Backup Button -->
                    <Border Grid.Row="2" Padding="25,20,25,25">
                        <Button Content="💾  Create Backup Now" Height="50"
                                Background="#16A34A" Foreground="White"
                                BorderThickness="0" FontSize="15" FontWeight="Bold"
                                Cursor="Hand" Click="CreateBackup_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#15803D"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Border>
                </Grid>
            </Border>

            <!-- ═══ RIGHT: Restore ═══ -->
            <Border Grid.Column="1" Background="White" CornerRadius="14" Margin="10,0,0,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Color="#CBD5E1" Opacity="0.4"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Card Header -->
                    <Border Background="#DC2626" CornerRadius="14,14,0,0" Padding="25,20">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔄" FontSize="28" VerticalAlignment="Center" Margin="0,0,14,0"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Restore Database" FontSize="20" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="Replace current data from a backup file"
                                           FontSize="12" Foreground="#FECACA"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Card Body -->
                    <StackPanel Grid.Row="1" Margin="25,24,25,0">
                        <TextBlock Text="Select Backup File (.db)" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#374151" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="RestorePathBox" Height="42" Padding="12,0"
                                     FontSize="13" VerticalContentAlignment="Center"
                                     BorderBrush="#CBD5E1" BorderThickness="1"
                                     Background="#F8FAFC" IsReadOnly="True"/>
                            <Button Grid.Column="1" Content="📂  Browse" Height="42"
                                    Padding="14,0" Margin="8,0,0,0"
                                    Background="#E2E8F0" BorderBrush="#CBD5E1"
                                    BorderThickness="1" FontSize="13" Cursor="Hand"
                                    Click="BrowseRestoreFile_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="7">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#CBD5E1"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                        <TextBlock Text="Select a previously saved  .db  backup file"
                                   FontSize="11" Foreground="#94A3B8" Margin="0,4,0,20"/>

                        <!-- Warning Box -->
                        <Border Background="#FEF2F2" CornerRadius="8" Padding="14,12"
                                BorderBrush="#FECACA" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="⚠  Important Warning" FontSize="12"
                                           FontWeight="Bold" Foreground="#991B1B" Margin="0,0,0,6"/>
                                <TextBlock Text="Restoring will permanently replace ALL current data."
                                           FontSize="12" Foreground="#374151" Margin="0,2" TextWrapping="Wrap"/>
                                <TextBlock Text="This action CANNOT be undone."
                                           FontSize="12" Foreground="#DC2626" FontWeight="Bold" Margin="0,4"/>
                                <TextBlock Text="It is strongly recommended to create a backup of your current data before restoring."
                                           FontSize="12" Foreground="#374151" Margin="0,2" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Restore Button -->
                    <Border Grid.Row="2" Padding="25,20,25,25">
                        <Button Content="🔄  Restore Database" Height="50"
                                Background="#DC2626" Foreground="White"
                                BorderThickness="0" FontSize="15" FontWeight="Bold"
                                Cursor="Hand" Click="RestoreBackup_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#B91C1C"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
