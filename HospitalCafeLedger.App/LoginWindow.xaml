<Window x:Class="HospitalCafeLedger.App.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cafe Management System — Login"
        Height="560" Width="960"
        MinHeight="560" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        WindowStyle="SingleBorderWindow"
        Background="#021E4A">

    <Window.Resources>
        <Storyboard x:Key="FadeIn">
            <DoubleAnimation Storyboard.TargetName="RootGrid"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.7"/>
            <DoubleAnimation Storyboard.TargetName="CardBorder"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                             From="35" To="0" Duration="0:0:0.55">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="CardBorder"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.55"/>
        </Storyboard>

        <Storyboard x:Key="LoginAnim">
            <DoubleAnimation Storyboard.TargetName="RootGrid"
                             Storyboard.TargetProperty="Opacity"
                             From="1" To="0" Duration="0:0:0.4" BeginTime="0:0:0.2">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>

    <Grid x:Name="RootGrid" Opacity="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.1*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT — Blue Branding Panel -->
        <Border>
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#021E4A" Offset="0"/>
                    <GradientStop Color="#0E4DB5" Offset="0.6"/>
                    <GradientStop Color="#1D6FE8" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <!-- Decorative circles -->
                <Ellipse Width="300" Height="300" HorizontalAlignment="Left"
                         VerticalAlignment="Top" Margin="-80,-80,0,0"
                         Fill="#FFFFFF" Opacity="0.04"/>
                <Ellipse Width="180" Height="180" HorizontalAlignment="Right"
                         VerticalAlignment="Bottom" Margin="0,0,-50,-50"
                         Fill="#FFFFFF" Opacity="0.06"/>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40,0">
                    <TextBlock Text="☕" FontSize="56" HorizontalAlignment="Center" Margin="0,0,0,14"/>
                    <TextBlock Text="Cafe Management" FontSize="26" FontWeight="Bold"
                               Foreground="White" HorizontalAlignment="Center"/>
                    <TextBlock Text="System" FontSize="26" FontWeight="Bold"
                               Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                    <Border Background="#FFFFFF" Opacity="0.15" Height="1" Margin="0,0,0,16"/>
                    <TextBlock Text="Your complete hospital cafe solution"
                               FontSize="12" Foreground="#93C5FD"
                               HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                    <WrapPanel HorizontalAlignment="Center" Margin="0,22,0,0">
                        <Border Background="#FFFFFF" Opacity="0.12" CornerRadius="20"
                                Padding="10,4" Margin="3,3">
                            <TextBlock Text="📊 Reports" FontSize="11" Foreground="White"/>
                        </Border>
                        <Border Background="#FFFFFF" Opacity="0.12" CornerRadius="20"
                                Padding="10,4" Margin="3,3">
                            <TextBlock Text="👨‍⚕️ Doctors" FontSize="11" Foreground="White"/>
                        </Border>
                        <Border Background="#FFFFFF" Opacity="0.12" CornerRadius="20"
                                Padding="10,4" Margin="3,3">
                            <TextBlock Text="🔮 AI Insights" FontSize="11" Foreground="White"/>
                        </Border>
                        <Border Background="#FFFFFF" Opacity="0.12" CornerRadius="20"
                                Padding="10,4" Margin="3,3">
                            <TextBlock Text="💳 Payments" FontSize="11" Foreground="White"/>
                        </Border>
                    </WrapPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- RIGHT — Login Card -->
        <Border x:Name="CardBorder" Grid.Column="1"
                Background="White" Opacity="0">
            <Border.RenderTransform>
                <TranslateTransform Y="35"/>
            </Border.RenderTransform>

            <StackPanel VerticalAlignment="Center" Margin="44,0,44,0">
                <TextBlock Text="Welcome Back" FontSize="24" FontWeight="Bold"
                           Foreground="#0F172A" Margin="0,0,0,4"/>
                <TextBlock Text="Sign in to continue" FontSize="13"
                           Foreground="#64748B" Margin="0,0,0,30"/>

                <!-- Email -->
                <TextBlock Text="Email Address" FontSize="12" FontWeight="SemiBold"
                           Foreground="#374151" Margin="0,0,0,5"/>
                <Border x:Name="EmailBorder" BorderBrush="#E2E8F0" BorderThickness="1"
                        CornerRadius="8" Margin="0,0,0,4">
                    <Grid>
                        <TextBlock Text="✉" FontSize="13" VerticalAlignment="Center"
                                   Foreground="#94A3B8" Margin="12,0,0,0"/>
                        <TextBox x:Name="EmailBox" Height="42" Padding="34,0,12,0"
                                 FontSize="13" VerticalContentAlignment="Center"
                                 BorderThickness="0" Background="Transparent"
                                 GotFocus="Field_GotFocus" LostFocus="Field_LostFocus"/>
                        <TextBlock x:Name="EmailPlaceholder" Text="admin@cafeledger.com"
                                   FontSize="12" Foreground="#CBD5E1"
                                   VerticalAlignment="Center" Margin="36,0,0,0"
                                   IsHitTestVisible="False"/>
                    </Grid>
                </Border>
                <TextBlock x:Name="EmailError" Text="" FontSize="11"
                           Foreground="#DC2626" Margin="0,0,0,10" Visibility="Collapsed"/>

                <!-- Password -->
                <TextBlock Text="Password" FontSize="12" FontWeight="SemiBold"
                           Foreground="#374151" Margin="0,0,0,5"/>
                <Border x:Name="PassBorder" BorderBrush="#E2E8F0" BorderThickness="1"
                        CornerRadius="8" Margin="0,0,0,4">
                    <Grid>
                        <TextBlock Text="🔒" FontSize="12" VerticalAlignment="Center"
                                   Foreground="#94A3B8" Margin="12,0,0,0"/>
                        <PasswordBox x:Name="PasswordBox" Height="42" Padding="34,0,12,0"
                                     FontSize="13" VerticalContentAlignment="Center"
                                     BorderThickness="0" Background="Transparent"
                                     GotFocus="Field_GotFocus" LostFocus="Field_LostFocus"
                                     KeyDown="Password_KeyDown"/>
                        <TextBlock x:Name="PassPlaceholder" Text="Enter your password"
                                   FontSize="12" Foreground="#CBD5E1"
                                   VerticalAlignment="Center" Margin="36,0,0,0"
                                   IsHitTestVisible="False"/>
                    </Grid>
                </Border>
                <TextBlock x:Name="PassError" Text="" FontSize="11"
                           Foreground="#DC2626" Margin="0,0,0,12" Visibility="Collapsed"/>

                <!-- Remember Me -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                    <CheckBox x:Name="RememberMe" VerticalAlignment="Center" Cursor="Hand"/>
                    <TextBlock Text="  Remember my credentials"
                               FontSize="12" Foreground="#374151"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Login Button -->
                <Button x:Name="LoginBtn" Content="Sign In  →"
                        Height="46" FontSize="14" FontWeight="Bold"
                        Foreground="White" BorderThickness="0"
                        Cursor="Hand" Click="Login_Click">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#0E4DB5" Offset="0"/>
                            <GradientStop Color="#1D6FE8" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="BtnBg" Background="{TemplateBinding Background}"
                                    CornerRadius="9">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="BtnBg" Property="Opacity" Value="0.88"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Error Banner -->
                <Border x:Name="ErrorBanner" Background="#FEF2F2" CornerRadius="8"
                        Padding="12,9" Margin="0,12,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="ErrorMsg" Text="" FontSize="12"
                               Foreground="#DC2626" TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</Window>
