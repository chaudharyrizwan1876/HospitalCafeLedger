<Window x:Class="HospitalCafeLedger.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cafe Management System"
        Height="680" Width="1150"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        WindowState="Normal"
        ResizeMode="CanResize"
        Background="#F4F6FA">

    <Window.Resources>
        <Style x:Key="NavBtn" TargetType="Button">
            <Setter Property="Height" Value="46"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#B0C4DE"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0A3A8A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="#032A63">
            <DockPanel>
                <Border DockPanel.Dock="Top" Background="#021E4A" Padding="20,22,20,20">
                    <StackPanel>
                        <TextBlock Text="Cafe Management" FontSize="18" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="System" FontSize="18" FontWeight="Bold" Foreground="White"/>
                    </StackPanel>
                </Border>

                <TextBlock DockPanel.Dock="Bottom"
                           Text="2026 Cafe Management System"
                           Foreground="#4A6FA5" Margin="20,12" FontSize="11"/>

                <StackPanel Margin="8,12,8,0">
                    <Button x:Name="BtnAI" Content="  🔮 AI Insights"
                            Style="{StaticResource NavBtn}"
                            Click="Nav_Click" Tag="Predictions"/>

                    <Separator Background="#1A3A6B" Margin="8,8"/>

                    <Button x:Name="BtnDashboard" Content="  Dashboard"
                            Style="{StaticResource NavBtn}"
                            Background="#0E4DB5" Foreground="White"
                            Click="Nav_Click" Tag="Dashboard"/>
                    <Button x:Name="BtnDoctors"  Content="  Doctors / Members"
                            Style="{StaticResource NavBtn}"
                            Click="Nav_Click" Tag="Doctors"/>
                    <Button x:Name="BtnItems"    Content="  Items / Recipes"
                            Style="{StaticResource NavBtn}"
                            Click="Nav_Click" Tag="Items"/>
                    <Button x:Name="BtnBilling"  Content="  Billing / New Order"
                            Style="{StaticResource NavBtn}"
                            Click="Nav_Click" Tag="Billing"/>
                    <Button x:Name="BtnPayments" Content="  Payments"
                            Style="{StaticResource NavBtn}"
                            Click="Nav_Click" Tag="Payments"/>
                    <Button x:Name="BtnLedger"   Content="  Ledger / History"
                            Style="{StaticResource NavBtn}"
                            Click="Nav_Click" Tag="Ledger"/>
                    <Button x:Name="BtnReports"  Content="  Reports"
                            Style="{StaticResource NavBtn}"
                            Click="Nav_Click" Tag="Reports"/>
                    <Button x:Name="BtnBackup"   Content="  Backup / Restore"
                            Style="{StaticResource NavBtn}"
                            Click="Nav_Click" Tag="Backup"/>

                    <Separator Background="#1A3A6B" Margin="8,12"/>

                    <Button x:Name="BtnLogout" Content="  Logout"
                            Style="{StaticResource NavBtn}"
                            Click="Logout_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Content Area -->
        <Grid x:Name="ContentArea" Grid.Column="1"/>
    </Grid>
</Window>
